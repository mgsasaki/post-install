# Brewfile — starting point for the Mac M5. Review/trim before running:
#   brew bundle --file=~/mac-migration/Brewfile
# Derived from tools detected on the Linux box. Versioned runtimes (node, java,
# ruby, python, gradle...) are best managed by mise/asdf via .tool-versions, so
# they're commented out here — uncomment if you prefer Homebrew to own them.

# --- core CLI ---
brew "git"
brew "git-lfs"
brew "gh"              # GitHub CLI
brew "wget"
brew "curl"
brew "coreutils"
brew "telnet"          # for your gogo-shell alias
brew "meld"            # git diff/merge tool (cask on mac: see below)
brew "jq"
brew "ripgrep"
brew "fzf"
brew "tree"
brew "watch"
brew "htop"
brew "tmux"
brew "neovim"
brew "ffmpeg"
brew "pandoc"          # you have pypandoc; native pandoc is handy
brew "ghostscript"
brew "graphviz"        # PlantUML / diagrams
brew "ncdu"
brew "lnav"            # log navigator — your custom formats restore to ~/.config/lnav

# --- shell / prompt ---
brew "bash"            # mac ships an ancient bash; this is current
brew "zsh"
brew "powerlevel10k"   # you use .p10k.zsh
brew "bash-git-prompt"

# --- runtime version manager ---
brew "asdf"            # reads your .tool-versions; setup.sh re-adds plugins from asdf-plugins.txt

