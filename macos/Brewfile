# --- AI desktop apps ---
cask "claude"                  # Claude Desktop

# --- mobile / embedded dev (you do Android + ESP/PlatformIO + Flutter) ---
cask "android-studio"
# Flutter/ESP-IDF: install via mise/.tool-versions + PlatformIO VS Code extension

# --- VMs on Apple Silicon (VirtualBox x86 VMs will NOT run natively) ---
cask "utm"                     # ARM-friendly VM host; or parallels-desktop / vmware-fusion
# Windows apps without a VM: brew install --cask whisky   (Wine/CrossOver for ARM)

